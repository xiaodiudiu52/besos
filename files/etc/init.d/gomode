#!/bin/sh /etc/rc.common

START=95
STOP=10

start() {
	# 只有场景设为「自动」时才开机探测网口
	[ "$(uci -q get gomode.main.mode)" = "auto" ] || exit 0

	# 等网络服务就绪再探测
	sleep 8

	/usr/bin/gomode auto

	# 补偿：开机那一刻 eth0 可能还是 down 的（netifd 就不会把它加进 br-lan），
	# 所以等网口真正就绪后再确认一次，确保有线永远可用
	(
		i=0
		while [ $i -lt 20 ]; do
			ip link show eth0 >/dev/null 2>&1 && break
			i=$((i+1))
			sleep 2
		done
		sleep 2
		# 只在网口属于 LAN 时挂桥（存在 wan 接口说明网口是 WAN，不能挂）
		if ! uci -q get network.wan >/dev/null 2>&1; then
			ip link set eth0 up 2>/dev/null
			ip link set eth0 master br-lan 2>/dev/null
		fi
	) &
}
