
config wifi-device 'radio0'
	option type 'mac80211'
	option path 'platform/10300000.wmac'
	option band '2g'
	option channel 'auto'
	option htmode 'HT20'
	option country 'CN'
	option disabled '0'

config wifi-iface 'default_radio0'
	option device 'radio0'
	option network 'lan'
	option mode 'ap'
	option ssid 'Go'
	option encryption 'none'

config wifi-iface 'sta_uplink'
	option device 'radio0'
	option network 'wwan'
	option mode 'sta'
	option ssid ''
	option encryption 'none'
	option disabled '1'
